{
  "schemaVersion": 1,
  "version": "1.0.0",
  "minimumManagerVersion": "1.0.0",
  "supportedBuilds": [
    {
      "build": 26200,
      "release": "25H2"
    },
    {
      "build": 26300,
      "release": "26H2"
    }
  ],
  "updatableFrom": [],
  "requirements": [
    "windows-security-off",
    "no-third-party-antivirus",
    "plugged-in"
  ],
  "estimatedMinutes": 15,
  "choices": [
    {
      "id": "defender",
      "kind": "single",
      "default": "defender-enable",
      "description": "Microsoft Defender is the antivirus built into Windows. Remove it only if you understand the risks and plan to use another antivirus app. Whichever you choose, Vanta turns off Smart App Control, Enhanced Phishing Protection and Find my device.",
      "learnMore": "https://support.microsoft.com/windows/stay-protected-with-windows-security-2ae0363d-0ada-c064-8b56-6a39afb6a963",
      "options": [
        {
          "id": "defender-enable",
          "label": "Keep Microsoft Defender (recommended)"
        }
      ]
    },
    {
      "id": "mitigations",
      "kind": "single",
      "default": "mitigations-default",
      "description": "These protections, also called security mitigations, help defend against processor flaws, such as Spectre and Meltdown, and against attacks that exploit bugs in apps. Keeping the Windows defaults is recommended.",
      "options": [
        {
          "id": "mitigations-default",
          "label": "Keep processor protections (recommended)"
        },
        {
          "id": "mitigations-disable",
          "label": "Turn off processor protections"
        }
      ]
    },
    {
      "id": "auto-updates",
      "kind": "single",
      "default": "auto-updates-disable",
      "description": "Windows updates include security fixes. You can have Windows install them automatically or install them yourself. Either way, Vanta keeps Windows on its current version, which gets security fixes only until Microsoft ends support for it. Vanta also turns off automatic updates for Microsoft Store apps, so update them in Microsoft Store.",
      "options": [
        {
          "id": "auto-updates-disable",
          "label": "Install updates myself"
        },
        {
          "id": "auto-updates-default",
          "label": "Install updates automatically"
        }
      ]
    },
    {
      "id": "keyboard",
      "kind": "single",
      "default": "keyboard-shortcuts",
      "description": "Choose how you switch keyboard languages.",
      "options": [
        {
          "id": "keyboard-shortcuts",
          "label": "Yes, with keyboard shortcuts"
        },
        {
          "id": "keyboard-selector",
          "label": "Yes, with the taskbar selector"
        },
        {
          "id": "keyboard-single",
          "label": "No, I use one keyboard layout"
        }
      ]
    },
    {
      "id": "system",
      "kind": "multiple",
      "options": [
        {
          "id": "disable-hibernation",
          "label": "Turn off hibernation"
        },
        {
          "id": "disable-power-saving",
          "label": "Turn off power saving"
        },
        {
          "id": "disable-core-isolation",
          "label": "Turn off virtualisation-based security (VBS)"
        }
      ]
    },
    {
      "id": "protections",
      "kind": "multiple",
      "description": "Windows protections that stay on unless you turn them off. Nothing here is turned off by default.",
      "options": [
        {
          "id": "disable-phishing-protection",
          "label": "Turn off Enhanced Phishing Protection (Windows stops warning when you type your password into a known phishing site)"
        },
        {
          "id": "disable-gamebar",
          "label": "Turn off Game Bar and game capture"
        }
      ]
    },
    {
      "id": "vanta",
      "kind": "multiple",
      "description": "Vanta extras. All are off unless you tick them.",
      "options": [
        {
          "id": "remove-store",
          "label": "Remove the Microsoft Store (App Installer and winget stay)"
        },
        {
          "id": "vanta-power",
          "label": "Use the Vanta power plan (desktop PCs only; skipped on laptops)"
        },
        {
          "id": "vanta-memory",
          "label": "Use the Vanta memory profile (memory compression on, page combining and app pre-launch off)"
        },
        {
          "id": "tools-on-logon",
          "label": "Open Vanta Tools the next time I sign in"
        }
      ]
    },
    {
      "id": "apps",
      "kind": "multiple",
      "options": [
        {
          "id": "remove-snipping-tool",
          "label": "Remove Snipping Tool"
        },
        {
          "id": "uninstall-edge",
          "label": "Remove Microsoft Edge"
        },
        {
          "id": "install-another-browser",
          "label": "Install a browser"
        }
      ]
    },
    {
      "id": "extras",
      "kind": "multiple",
      "options": [
        {
          "id": "install-eclean",
          "label": "Install eclean"
        }
      ]
    },
    {
      "id": "browser",
      "kind": "single",
      "default": "browser-brave",
      "dependsOn": "install-another-browser",
      "description": "Choose a browser to install. Vanta won't change your browser settings.",
      "options": [
        {
          "id": "browser-brave",
          "label": "Brave",
          "image": "brave"
        },
        {
          "id": "browser-librewolf",
          "label": "LibreWolf",
          "image": "librewolf"
        },
        {
          "id": "browser-firefox",
          "label": "Firefox",
          "image": "firefox"
        },
        {
          "id": "browser-chrome",
          "label": "Chrome",
          "image": "chrome"
        }
      ]
    }
  ],
  "vanta": {
    "toolsVersion": "0.1.0"
  }
}
