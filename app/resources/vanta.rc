// The process manifest (DPI awareness, asInvoker) is embedded here, per binary: gpui's windows-manifest
// feature is off, so VantaTools can ask for administrator in its own manifest.
// build.rs supplies the icon path and the version fields: the Cargo package
// version, with the RC number as the fourth numeric component on a tester build.
1 ICON "@ICON@"
#define RT_MANIFEST 24
1 RT_MANIFEST "@MANIFEST@"

// FILETYPE 1 is VFT_APP. 040904B0 and the Translation pair 0x0409, 1200 mean
// US English strings in Unicode (code page 1200).
1 VERSIONINFO
FILEVERSION @NUMERIC_VERSION@
PRODUCTVERSION @NUMERIC_VERSION@
FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Vanta\0"
            VALUE "FileDescription", "Vanta Manager\0"
            VALUE "ProductName", "Vanta Manager\0"
            VALUE "LegalCopyright", "GPL-3.0. Based on Atlas 0.6.0.\0"
            VALUE "InternalName", "VantaManager\0"
            VALUE "OriginalFilename", "VantaManager.exe\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "ProductVersion", "@VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
